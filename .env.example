# Which vision model identifies parts on photos: anthropic | ollama
PARTSBIN_PROVIDER=anthropic
# PARTSBIN_LANGUAGE=English       # language of recognized descriptions

# --- Anthropic (cloud) ---
ANTHROPIC_API_KEY=sk-ant-...
# PARTSBIN_MODEL=claude-opus-5-5
# PARTSBIN_EFFORT=medium          # low | medium | high

# --- Ollama (local) ---
# OLLAMA_URL=http://host.docker.internal:11434   # Ollama on the Docker host
# OLLAMA_URL=http://ollama:11434                 # bundled container (--profile ollama)
# OLLAMA_URL=http://192.168.1.50:11434           # Ollama elsewhere in the LAN/tailnet
# OLLAMA_MODEL=qwen2.5vl:7b       # must be a vision model
# OLLAMA_TIMEOUT=300              # seconds; CPU-only inference is slow
# OLLAMA_THINK=false             # let thinking-capable models reason first (slower)
# PARTSBIN_MAX_EDGE=1024          # image size sent to the model
